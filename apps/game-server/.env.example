REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="dev-insecure-secret-change-me"
# Comma-separated list of allowed frontend origins (no trailing slash)
WEB_ORIGIN="http://localhost:3000,https://your-app.vercel.app"
