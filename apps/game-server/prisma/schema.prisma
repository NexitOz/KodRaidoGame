generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CardType {
  CHARACTER
  TRACK
  RUNE
  EVENT
  EDIT
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  RAIDO
}

enum RightsStatus {
  owned
  licensed
  placeholder
  blocked
}

enum MatchStatus {
  ACTIVE
  FINISHED
  ABANDONED
}

enum BotDifficulty {
  EASY
  NORMAL
  HARD
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  avatarUrl    String?
  level        Int      @default(1)
  xp           Int      @default(0)
  softCurrency Int      @default(500)
  mmr          Int      @default(1000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection       CollectionEntry[]
  decks            Deck[]
  refreshTokens    RefreshToken[]
  matchesAsPlayer1 Match[]           @relation("Player1Matches")
  matchesAsPlayer2 Match[]           @relation("Player2Matches")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Track {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  coverUrl        String
  audioPreviewUrl String?
  releaseUrl      String?
  releaseDate     DateTime?
  createdAt       DateTime  @default(now())

  mediaAssets MediaAsset[]

  @@map("tracks")
}

model MediaAsset {
  id            String   @id @default(uuid())
  provider      String
  externalId    String
  type          String
  url           String
  linkedTrackId String?
  linkedTrack   Track?   @relation(fields: [linkedTrackId], references: [id])
  metadataJson  Json?
  createdAt     DateTime @default(now())

  metricSnapshots MetricSnapshot[]

  @@unique([provider, externalId])
  @@map("media_assets")
}

model MetricSnapshot {
  id           String   @id @default(uuid())
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  capturedAt   DateTime @default(now())
  views        Int      @default(0)
  listens      Int      @default(0)
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)
  soundUses    Int      @default(0)
  saves        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([mediaAssetId, capturedAt])
  @@map("metric_snapshots")
}

model Card {
  id     String   @id @default(uuid())
  slug   String   @unique
  name   String
  type   CardType
  rarity Rarity
  cost   Int
  tags   String[]

  // Character-only fields
  attack          Int?
  health          Int?
  universe        String?
  voiceStingerUrl String?

  // Track-only fields
  coverUrl        String?
  audioPreviewUrl String?
  releaseUrl      String?
  releaseDate     DateTime?

  // Edit-only fields
  videoUrl String?

  artworkUrl       String
  abilityText      String?
  effectJson       Json         @default("[]")
  linkedTrackIds   String[]
  boostProfileId   String?
  rightsStatus     RightsStatus @default(placeholder)
  rightsNote       String?
  source           String?
  licenseExpiresAt DateTime?
  isPlayable       Boolean      @default(true)
  active           Boolean      @default(true)
  isToken          Boolean      @default(false)
  resonanceTier    Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  collectionEntries  CollectionEntry[]
  deckCards          DeckCard[]
  resonanceSnapshots ResonanceSnapshot[]

  @@map("cards")
}

model ResonanceSnapshot {
  id           String   @id @default(uuid())
  cardId       String
  card         Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  score        Float
  tier         Int
  boostPercent Float
  calculatedAt DateTime @default(now())
  validUntil   DateTime
  reasonsJson  Json     @default("{}")

  @@index([cardId, calculatedAt])
  @@map("resonance_snapshots")
}

model CollectionEntry {
  userId   String
  cardId   String
  quantity Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
  @@map("collections")
}

model Deck {
  id        String   @id @default(uuid())
  userId    String
  name      String
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards DeckCard[]

  @@map("decks")
}

model DeckCard {
  deckId   String
  cardId   String
  quantity Int    @default(1)

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([deckId, cardId])
  @@map("deck_cards")
}

model Match {
  id                  String         @id @default(uuid())
  player1Id           String
  player2Id           String?
  player2IsBot        Boolean        @default(false)
  botDifficulty       BotDifficulty?
  status              MatchStatus    @default(ACTIVE)
  seed                String
  winnerId            String?
  boostSnapshotJson   Json           @default("[]")
  /// player1's reward (the only human's reward for PvE matches).
  xpAwarded           Int            @default(0)
  softCurrencyAwarded Int            @default(0)
  /// player2's reward - only set for ranked PvP matches (player2IsBot = false).
  player2XpAwarded           Int?
  player2SoftCurrencyAwarded Int?
  /// Only set for ranked PvP matches - signed MMR change for player1/player2 respectively.
  player1MmrDelta     Int?
  player2MmrDelta     Int?
  startedAt           DateTime       @default(now())
  finishedAt          DateTime?

  player1 User         @relation("Player1Matches", fields: [player1Id], references: [id], onDelete: Cascade)
  player2 User?        @relation("Player2Matches", fields: [player2Id], references: [id])
  events  MatchEvent[]

  @@index([player1Id])
  @@map("matches")
}

model MatchEvent {
  id          String   @id @default(uuid())
  matchId     String
  sequence    Int
  type        String
  payloadJson Json
  createdAt   DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, sequence])
  @@map("match_events")
}
