{
  "name": "kod-raido-resonance",
  "private": true,
  "version": "0.1.0",
  "description": "Kod Raido: Resonance - browser collectible card PvP game",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "npm run dev -w apps/web",
    "dev:server": "npm run dev -w apps/game-server",
    "dev:worker": "npm run dev -w apps/worker",
    "prisma:generate": "npm run prisma:generate -w apps/game-server",
    "prisma:migrate": "npm run prisma:migrate -w apps/game-server",
    "seed": "npm run seed -w apps/game-server"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
